    "%@ in %@, %@. Each point shows only its own period. Tap, hold, or drag across dates to select activity." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ in %2$@, %3$@. Jeder Punkt zeigt nur seinen eigenen Zeitraum. Tippen, halten oder ziehen Sie über die Daten, um eine Aktivität auszuwählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in %@, %@. Each point shows only its own period. Tap, hold, or drag across dates to select activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en %2$@, %3$@. Cada punto muestra solo su propio periodo. Toca, mantén pulsado o arrastra por las fechas para seleccionar actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dans %2$@, %3$@. Chaque point montre uniquement sa propre période. Appuyez, maintenez ou faites glisser sur les dates pour sélectionner une activité."
          }
        },

    "iOS may simplify backgrounds when widgets are tinted or their backgrounds are removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vereinfacht möglicherweise Hintergründe, wenn Widgets getönt oder ihre Hintergründe entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS may simplify backgrounds when widgets are tinted or their backgrounds are removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS puede simplificar los fondos cuando los widgets tienen un tinte o se eliminan sus fondos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS peut simplifier les arrière-plans lorsque les widgets sont teintés ou que leurs arrière-plans sont supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS può semplificare gli sfondi quando i widget vengono colorati o i relativi sfondi vengono rimossi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS može da pojednostavi pozadinu kada su vidžeti zatamnjeni ili njihova pozadina uklonjena."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当小部件着色或背景被删除时，iOS 可能会简化背景。"
          }
        }
      }

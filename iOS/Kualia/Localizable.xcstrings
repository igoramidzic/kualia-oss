    "Text matching ignores case. Imports use the bank's merchant name; existing transactions use their current merchant." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Textabgleich wird die Groß-/Kleinschreibung ignoriert. Bei Importen wird der Händlername der Bank verwendet; Bestehende Transaktionen nutzen ihren aktuellen Händler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text matching ignores case. Imports use the bank's merchant name; existing transactions use their current merchant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coincidencia de texto no distingue mayúsculas. Las importaciones usan el nombre bancario del comercio; las transacciones existentes usan el comercio actual."

    "Joining will delete your current family, %@, and revoke its pending invitations. Your own workspaces stay with you." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch den Beitritt wird Ihre aktuelle Familie, %1$@, gelöscht und die ausstehenden Einladungen widerrufen. Ihre eigenen Arbeitsbereiche bleiben bei Ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joining will delete your current family, %@, and revoke its pending invitations. Your own workspaces stay with you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al unirte se eliminará tu familia actual, %@, y se revocarán sus invitaciones pendientes. Tus propios espacios seguirán contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoindre supprimera votre famille actuelle, %1$@, et révoquera ses invitations en attente. Vos propres espaces de travail restent avec vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adesione eliminerà la tua famiglia attuale, %1$@, e revocherà i relativi inviti in sospeso. I tuoi spazi di lavoro restano con te."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridruživanje će izbrisati vašu trenutnu porodicu, %1$@, i opozvati njene pozive na čekanju. Vaš radni prostor ostaje sa vama."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入将删除您当前的家庭 %1$@，并撤销其待处理的邀请。您自己的工作空间将陪伴您左右。"
          }
        }
      }
    },

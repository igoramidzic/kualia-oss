    },
    " Add it to your transactions when you're ready." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Fügen Sie es zu Ihren Transaktionen hinzu, wenn Sie bereit sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Add it to your transactions when you're ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Añádela a tus transacciones cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Ajoutez-le à vos transactions lorsque vous êtes prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Aggiungilo alle tue transazioni quando sei pronto."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Dodajte ga u svoje transakcije kada budete spremni."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 准备好后将其添加到您的交易中。"
          }
        }
      }
    },
    " Kualia adds it to your transactions on the due date." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kualia fügt es am Fälligkeitsdatum zu Ihren Transaktionen hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kualia adds it to your transactions on the due date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kualia la añade a tus transacciones en la fecha prevista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kualia l'ajoute à vos transactions à la date d'échéance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kualia lo aggiunge alle tue transazioni alla data di scadenza."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kualia dodaje ga u svoje transakcije na datum dospeća."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Kualia 在到期日将其添加到您的交易中。"
          }
        }
      }
    },

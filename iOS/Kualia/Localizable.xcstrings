    "By joining, they'll be able to see and edit family workspaces, including accounts, balances, and transactions. They must use this email address to accept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch den Beitritt können sie Familienarbeitsbereiche sehen und bearbeiten, einschließlich Konten, Salden und Transaktionen. Sie müssen zum Akzeptieren diese E-Mail-Adresse verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By joining, they'll be able to see and edit family workspaces, including accounts, balances, and transactions. They must use this email address to accept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al unirse, podrán ver y editar los espacios familiares, incluidas cuentas, saldos y transacciones. Deben usar este correo para aceptar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rejoignant, ils pourront voir et modifier les espaces de travail familiaux, y compris les comptes, les soldes et les transactions. Ils doivent utiliser cette adresse e-mail pour accepter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aderendo, potranno vedere e modificare gli spazi di lavoro familiari, inclusi conti, saldi e transazioni. Devono utilizzare questo indirizzo email per accettare."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako se pridruže, moći će da vide i uređuju porodične radne prostore, uključujući račune, stanja i transakcije. Moraju koristiti ovu adresu e-pošte da bi prihvatili."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过加入，他们将能够查看和编辑家庭工作区，包括帐户、余额和交易。他们必须使用此电子邮件地址才能接受。"
          }
        }
      }
    },

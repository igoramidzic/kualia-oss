    "Dismissing a notice only clears it from Home. Unresolved items return tomorrow, or sooner if something changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Ablehnen einer Benachrichtigung wird diese lediglich aus der Startseite gelöscht. Ungelöste Elemente werden morgen zurückgegeben, oder früher, wenn sich etwas ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dismissing a notice only clears it from Home. Unresolved items return tomorrow, or sooner if something changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descartar un aviso solo lo quita de Inicio. Los asuntos pendientes volverán mañana, o antes si algo cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rejet d’un avis l’efface uniquement de l’accueil. Les éléments non résolus reviennent demain, ou plus tôt si quelque chose change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorare un avviso lo cancella solo da Home. Gli elementi irrisolti torneranno domani o prima se qualcosa cambia."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odbacivanje obaveštenja samo ga briše iz kuće. Nerešene stavke se vraćaju sutra, ili ranije ako se nešto promeni."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略通知只会将其从主页中清除。未解决的项目将于明天返回，如果有变化，则更早返回。"
          }
        }
      }
    },

    "How much of the monthly target is funded, rounded down to a whole percent. The bar fills as you get closer to covering this month's targets." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der finanzierte Anteil des Monatsziels, auf eine ganze Prozentzahl abgerundet. Der Balken füllt sich, je näher du der vollständigen Finanzierung deiner Ziele für diesen Monat kommst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much of the monthly target is funded, rounded down to a whole percent. The bar fills as you get closer to covering this month's targets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte del objetivo mensual que está financiada, redondeada hacia abajo a un porcentaje entero. La barra se llena a medida que te acercas a cubrir los objetivos de este mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La part de l’objectif mensuel qui est financée, arrondie au pourcentage entier inférieur. La barre se remplit à mesure que vous couvrez les objectifs de ce mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte dell’obiettivo mensile finanziata, arrotondata per difetto a una percentuale intera. La barra si riempie man mano che ti avvicini a coprire gli obiettivi di questo mese."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deo mesečnog cilja koji je finansiran, zaokružen naniže na ceo procenat. Traka se popunjava kako se približavaš ispunjenju ciljeva za ovaj mesec."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月度目标已筹集资金的比例，向下取整为整数百分比。随着本月目标逐步得到满足，进度条会逐渐填满。"
          }
        }
      }
    },

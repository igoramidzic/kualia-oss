    "%@ will lose shared family workspace and membership access. Their Kualia account and own workspaces stay intact. Bank links crossing between them and the family will be unlinked." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verliert den gemeinsamen Familienarbeitsbereich und den Mitgliedschaftszugriff. Ihr Kualia-Konto und ihre eigenen Arbeitsbereiche bleiben erhalten. Die zwischen ihnen und der Familie bestehenden Bankverbindungen werden aufgehoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will lose shared family workspace and membership access. Their Kualia account and own workspaces stay intact. Bank links crossing between them and the family will be unlinked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ perderá el acceso a los espacios y la suscripción familiar. Su cuenta de Kualia y sus espacios propios se conservarán. Se desvincularán las conexiones bancarias compartidas entre esa persona y la familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ perdra l’espace de travail familial partagé et l’accès aux membres. Leur compte Kualia et leurs propres espaces de travail restent intacts. Les liens bancaires qui les unissent à la famille seront dissociés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ perderà lo spazio di lavoro familiare condiviso e l'accesso ai membri. Il loro account Kualia e i propri spazi di lavoro rimangono intatti. I collegamenti bancari che si incrociano tra loro e la famiglia verranno scollegati."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ će izgubiti deljeni porodični radni prostor i pristup članstvu. Njihov Kualia nalog i sopstveni radni prostori ostaju netaknuti. Bankovne veze koje se prelaze između njih i porodice biće prekinute."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 将失去共享家庭工作区和成员资格访问权限。他们的 Kualia 帐户和自己的工作区保持不变。他们和家人之间的银行联系将被取消。"
          }
        }
      }
    },
    "%@ will stop running. Transactions it already changed stay as they are." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wird nicht mehr ausgeführt. Bereits geänderte Transaktionen bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will stop running. Transactions it already changed stay as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dejará de ejecutarse. Las transacciones que ya modificó se mantendrán igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ cessera de fonctionner. Les transactions déjà modifiées restent telles quelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ smetterà di funzionare. Le transazioni già modificate rimangono invariate."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ će prestati da se izvršava. Transakcije koje je već promenio ostaju kakve jesu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@将停止运行。已更改的事务保持原样。"
          }
        }
      }
    },

    },
    "The target contributions and extra spending already covered. Surplus in one category does not cover another category's shortfall." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die bereits gedeckten Zielbeiträge und zusätzlichen Ausgaben. Ein Überschuss in einer Kategorie deckt keinen Fehlbetrag in einer anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The target contributions and extra spending already covered. Surplus in one category does not cover another category's shortfall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aportaciones a los objetivos y los gastos adicionales ya cubiertos. El excedente de una categoría no cubre el déficit de otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contributions aux objectifs et les dépenses supplémentaires déjà couvertes. L’excédent d’une catégorie ne couvre pas le manque d’une autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contributi agli obiettivi e le spese aggiuntive già coperti. L’avanzo in una categoria non copre la carenza di un’altra."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Već pokriveni doprinosi ciljevima i dodatna potrošnja. Višak u jednoj kategoriji ne pokriva manjak u drugoj."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已覆盖的目标资金和额外支出。一个类别的结余不会抵消另一个类别的资金缺口。"
          }
        }
      }
    },
    "The time zone keeps budget months and planned transactions consistent when you travel. Changing currency changes how amounts are displayed; it doesn't convert balances." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Zeitzone bleiben Budgetmonate und geplante Transaktionen auf Reisen konsistent. Durch das Ändern der Währung ändert sich die Art und Weise, wie Beträge angezeigt werden. Es werden keine Guthaben umgerechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The time zone keeps budget months and planned transactions consistent when you travel. Changing currency changes how amounts are displayed; it doesn't convert balances."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zona horaria mantiene coherentes los meses y las transacciones planificadas cuando viajas. Cambiar la moneda cambia cómo se muestran los importes; no convierte los saldos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fuseau horaire permet de maintenir la cohérence des mois budgétaires et des transactions planifiées lorsque vous voyagez. Changer la devise modifie la façon dont les montants sont affichés ; il ne convertit pas les soldes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fuso orario mantiene coerenti i mesi del budget e le transazioni pianificate durante il viaggio. La modifica della valuta modifica la modalità di visualizzazione degli importi; non converte i saldi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vremenska zona održava budžetske mesece i planirane transakcije doslednim kada putujete. Promena valute menja način na koji se iznosi prikazuju; ne konvertuje bilanse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时区使您旅行时的预算月份和计划交易保持一致。更改货币会改变金额的显示方式；它不会转换余额。"
          }
        }
      }
    },

    "Funded can fall below zero when money is removed from target categories, increasing what's left to add." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der finanzierte Betrag kann unter null fallen, wenn du Geld aus Kategorien mit Zielen entfernst. Dadurch steigt der noch benötigte Betrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funded can fall below zero when money is removed from target categories, increasing what's left to add."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El importe financiado puede bajar de cero si retiras dinero de categorías con objetivos, lo que aumenta la cantidad pendiente de añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le montant financé peut devenir négatif si vous retirez de l’argent de catégories ayant des objectifs, ce qui augmente la somme restant à ajouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importo finanziato può scendere sotto zero se rimuovi denaro dalle categorie con obiettivi, aumentando quanto resta da aggiungere."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finansirani iznos može pasti ispod nule kada ukloniš novac iz kategorija sa ciljevima, čime se povećava iznos koji još treba dodati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从设有目标的类别中移出资金时，已筹集金额可能变为负数，需要追加的金额也会随之增加。"
          }
        }
      }
    },

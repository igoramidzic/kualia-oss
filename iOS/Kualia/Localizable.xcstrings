    "Rule saved, but applying to existing transactions wasn't confirmed. Retry Save, or turn off Apply now to finish." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Regel wurde gespeichert, die Anwendung auf bestehende Transaktionen wurde jedoch nicht bestätigt. Versuchen Sie es erneut mit dem Speichern, oder deaktivieren Sie „Jetzt anwenden“, um den Vorgang abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rule saved, but applying to existing transactions wasn't confirmed. Retry Save, or turn off Apply now to finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regla guardada, pero no se confirmó su aplicación a las transacciones existentes. Vuelve a guardar o desactiva Aplicar ahora para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La règle a été enregistrée, mais son application aux transactions existantes n'a pas été confirmée. Réessayez Enregistrer ou désactivez Appliquer maintenant pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola salvata, ma l'applicazione alle transazioni esistenti non è stata confermata. Riprova a salvare o disattiva Applica ora per terminare."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravilo je sačuvano, ali primena na postojeće transakcije nije potvrđena. Pokušajte ponovo da sačuvate ili isključite Primeni sada da biste završili."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规则已保存，但未确认应用于现有交易。重试“保存”，或关闭“立即应用”以完成。"
          }
        }
      }
    },

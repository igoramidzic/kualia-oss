    "Your data stays intact. Syncing and notifications pause until you restore the workspace." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Daten bleiben erhalten. Die Synchronisierung und Benachrichtigungen werden angehalten, bis Sie den Arbeitsbereich wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {

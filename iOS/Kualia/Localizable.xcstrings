          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割加起来为%1$@。匹配交易总额或使用这个新的总额。"
          }
        }
      }
    },
    "The split total is too large. Reduce an amount to continue." : {

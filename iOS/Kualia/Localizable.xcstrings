        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeros %1$lld de %2$lld. Toda la actividad está incluida en el total y la lista de transacciones."
          }
        },
        "fr" : {
          "stringUnit" : {

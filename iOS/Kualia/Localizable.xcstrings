          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podesite iznos, rashod ili prihod, trgovca, račun, kategoriju, datum, beleške i ponavljanje. Za prenose izaberite Prenos i odredišni račun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "Apple Wallet access is managed on the device that shared these accounts." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Der Wallet-Zugriff wird auf dem Gerät verwaltet, das diese Konten freigegeben hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Wallet access is managed on the device that shared these accounts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso de Apple Wallet se gestiona en el dispositivo que compartió estas cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès au portefeuille Apple est géré sur l'appareil qui a partagé ces comptes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple L'accesso al portafoglio è gestito sul dispositivo che ha condiviso questi account."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pristupom novčaniku se upravlja na uređaju koji deli ove naloge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 钱包访问在共享这些帐户的设备上进行管理。"
          }
        }
      }
    },
    "Apple Wallet updates will stop for this workspace. Your Kualia accounts and transaction history will be kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Wallet-Updates werden für diesen Arbeitsbereich gestoppt. Ihre Kualia-Konten und der Transaktionsverlauf werden gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Wallet updates will stop for this workspace. Your Kualia accounts and transaction history will be kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones de Apple Wallet se detendrán para este espacio. Se conservarán tus cuentas e historial de transacciones de Kualia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour du portefeuille Apple s’arrêteront pour cet espace de travail. Vos comptes Kualia et l'historique des transactions seront conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Gli aggiornamenti di Wallet verranno interrotti per questa area di lavoro. I tuoi account Kualia e la cronologia delle transazioni verranno conservati."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Ažuriranja Novčanika će se zaustaviti za ovaj radni prostor. Vaši Kualia nalozi i istorija transakcija će biti sačuvani."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 此工作区的钱包更新将停止。您的 Kualia 帐户和交易历史记录将被保留。"
          }
        }
      }
    },
    "Applies to every %@ widget in your active workspace, in every size. Saved on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für jedes %1$@-Widget in Ihrem aktiven Arbeitsbereich, in jeder Größe. Auf diesem Gerät gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to every %@ widget in your active workspace, in every size. Saved on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a todos los widgets de %@ de tu espacio activo, en todos los tamaños. Se guarda en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique à chaque widget %1$@ de votre espace de travail actif, dans toutes les tailles. Enregistré sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica a ogni widget %1$@ nell'area di lavoro attiva, in ogni dimensione. Salvato su questo dispositivo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primenjuje se na svaki %1$@ vidžet u vašem aktivnom radnom prostoru, u svakoj veličini. Sačuvano na ovom uređaju."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于活动工作区中的每个 %1$@ 小部件，各种尺寸。保存在此设备上。"
          }
        }
      }
    },

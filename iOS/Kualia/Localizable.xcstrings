    "Adds a transaction dated today and updates your Kualia balances. A repeating transaction advances to its next future date." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine Transaktion mit heutigem Datum hinzu und aktualisiert Ihre Kualia-Salden. Eine wiederkehrende Transaktion wird auf ihr nächstes zukünftiges Datum verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a transaction dated today and updates your Kualia balances. A repeating transaction advances to its next future date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una transacción con fecha de hoy y actualiza tus saldos de Kualia. Una transacción recurrente avanza a su próxima fecha futura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une transaction datée d'aujourd'hui et met à jour vos soldes Kualia. Une transaction répétitive avance à sa prochaine date future."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una transazione datata oggi e aggiorna i saldi Kualia. Una transazione ricorrente avanza alla successiva data futura."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje transakciju od danas i ažurira vaše stanje Kualia. Transakcija koja se ponavlja prelazi na sledeći budući datum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加今天的交易并更新您的 Kualia 余额。重复交易前进到下一个未来日期。"
          }
        }
      }
    },

    "Move this group’s categories, including archived ones, to another group. Their transactions, targets, and assigned money stay with them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschieben Sie die Kategorien dieser Gruppe, einschließlich archivierter Kategorien, in eine andere Gruppe. Ihre Transaktionen, Ziele und zugewiesenen Beträge bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move this group’s categories, including archived ones, to another group. Their transactions, targets, and assigned money stay with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve las categorías de este grupo, incluidas las archivadas, a otro grupo. Conservarán sus transacciones, objetivos y dinero asignado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez les catégories de ce groupe, y compris celles archivées, vers un autre groupe. Leurs transactions, objectifs et montants attribués seront conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta le categorie di questo gruppo, incluse quelle archiviate, in un altro gruppo. Le loro transazioni, gli obiettivi e il denaro assegnato resteranno invariati."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premestite kategorije ove grupe, uključujući arhivirane, u drugu grupu. Njihove transakcije, ciljevi i raspoređeni novac ostaju uz njih."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此分组的类别（包括已归档类别）移至另一个分组。其交易、目标和已分配资金将保留。"
          }
        }
      }
    },

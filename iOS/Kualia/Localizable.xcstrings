    "Your bank connection is available. New activity arrives as your bank shares it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Bankverbindung ist verfügbar. Neue Aktivitäten treffen ein, sobald Ihre Bank sie mitteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your bank connection is available. New activity arrives as your bank shares it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu conexión bancaria está disponible. La actividad nueva llega cuando la comparte tu banco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre connexion bancaire est disponible. Une nouvelle activité arrive au fur et à mesure que votre banque la partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua connessione bancaria è disponibile. La nuova attività arriva non appena la tua banca la condivide."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša veza sa bankom je dostupna. Nova aktivnost stiže čim je vaša banka deli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的银行连接可用。当您的银行分享新活动时，就会出现新活动。"
          }
        }
      }
    },
    "Your bank connection is being saved. Changes already submitted may still finish if you leave. Check your connections before trying again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Bankverbindung wird gespeichert. Bereits übermittelte Änderungen werden möglicherweise noch wirksam, wenn Sie die Seite verlassen. Überprüfen Sie Ihre Verbindungen, bevor Sie es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your bank connection is being saved. Changes already submitted may still finish if you leave. Check your connections before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está guardando tu conexión bancaria. Los cambios enviados podrían completarse aunque salgas. Revisa tus conexiones antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre connexion bancaire est en cours de sauvegarde. Les modifications déjà soumises peuvent encore être terminées si vous quittez. Vérifiez vos connexions avant de réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua connessione bancaria è in fase di salvataggio. Le modifiche già inviate potrebbero comunque essere completate se esci. Controlla le connessioni prima di riprovare."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša veza sa bankom se čuva. Promene koje su već poslate mogu i dalje biti završene ako odete. Proverite svoje veze pre nego što pokušate ponovo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在保存您的银行连接。如果您离开，已提交的更改可能仍会完成。重试之前请检查您的连接。"
          }
        }
      }
    },

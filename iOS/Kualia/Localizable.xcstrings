        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios siguen la hora local de este dispositivo. Desactivar las notificaciones también pausa los recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

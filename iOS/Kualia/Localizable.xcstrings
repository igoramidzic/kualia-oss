    "Tap a month to select it. Hold another month to select the months in between." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Monat, um ihn auszuwählen. Halte einen anderen Monat gedrückt, um auch die Monate dazwischen auszuwählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a month to select it. Hold another month to select the months in between."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un mes para seleccionarlo. Mantén pulsado otro mes para seleccionar también los meses intermedios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un mois pour le sélectionner. Appuyez longuement sur un autre mois pour sélectionner aussi les mois entre les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un mese per selezionarlo. Tieni premuto un altro mese per selezionare anche i mesi intermedi."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirni mesec da ga izabereš. Zadrži prst na drugom mesecu da izabereš i sve mesece između."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点一个月份进行选择。长按另一个月份，即可同时选择两者之间的月份。"
          }
        }
      }
    },
    "Tap a shortcut to open Kualia and finish your entry. Lock Screen and Control Center shortcuts open a new expense. Nothing is saved until you finish the form." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf eine Verknüpfung, um Kualia zu öffnen und Ihre Eingabe abzuschließen. Die Verknüpfungen „Sperrbildschirm“ und „Kontrollzentrum“ öffnen eine neue Ausgabe. Es wird nichts gespeichert, bis Sie das Formular ausfüllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a shortcut to open Kualia and finish your entry. Lock Screen and Control Center shortcuts open a new expense. Nothing is saved until you finish the form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un acceso rápido para abrir Kualia y completar el movimiento. Los accesos de la pantalla bloqueada y el Centro de control abren un gasto nuevo. No se guarda nada hasta que completes el formulario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un raccourci pour ouvrir Kualia et terminer votre saisie. Les raccourcis de l’écran de verrouillage et du centre de contrôle ouvrent une nouvelle dépense. Rien n'est enregistré tant que vous n'avez pas terminé le formulaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una scorciatoia per aprire Kualia e completare l'inserimento. Le scorciatoie della schermata di blocco e del Centro di controllo aprono una nuova spesa. Niente viene salvato finché non finisci il modulo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite prečicu da otvorite Kualia i završite unos. Prečice na zaključanom ekranu i kontrolnom centru otvaraju novi trošak. Ništa se ne čuva dok ne završite obrazac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击快捷方式打开Kualia并完成输入。锁定屏幕和控制中心快捷方式打开新的费用。在您完成表格之前，不会保存任何内容。"
          }
        }
      }
    },
    "Tap Add a Control, search for Kualia, and choose Add Transaction." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf „Kontrolle hinzufügen“, suchen Sie nach Kualia und wählen Sie „Transaktion hinzufügen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Add a Control, search for Kualia, and choose Add Transaction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Añadir un control, busca Kualia y elige Añadir transacción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Ajouter un contrôle, recherchez Kualia et choisissez Ajouter une transaction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Aggiungi un controllo, cerca Kualia e scegli Aggiungi transazione."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite Dodaj kontrolu, potražite Kualia i izaberite Dodaj transakciju."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击添加控件，搜索 Kualia，然后选择添加事务。"
          }
        }
      }
    },
    "Tap between net worth, assets, and debt for the accounts you choose." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {

    "A future date replaces this ledger entry with a planned transaction. Account balances will update. Transfer entries move together." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein zukünftiges Datum ersetzt diesen Hauptbucheintrag durch eine geplante Transaktion. Der Kontostand wird aktualisiert. Übertragungseinträge werden zusammen verschoben."
          }
        },
        "en" : {

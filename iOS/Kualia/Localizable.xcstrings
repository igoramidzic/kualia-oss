    "Member removed. Their own workspaces stay with them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitglied entfernt. Ihre eigenen Arbeitsplätze bleiben bei ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Member removed. Their own workspaces stay with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miembro eliminado. Sus propios espacios siguen con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membre supprimé. Leurs propres espaces de travail restent avec eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membro rimosso. I loro spazi di lavoro rimangono con loro."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Član je uklonjen. Njihovi radni prostori ostaju sa njima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成员已删除。他们自己的工作空间始终伴随着他们。"
          }
        }
      }
    },
    "Members can see and edit family budgets, accounts, and transactions. Bank connections stay with their owner. Leaving keeps your own workspaces and removes shared access." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitglieder können Familienbudgets, Konten und Transaktionen einsehen und bearbeiten. Bankverbindungen bleiben beim Eigentümer. Beim Verlassen bleiben Ihre eigenen Arbeitsbereiche erhalten und der gemeinsame Zugriff wird entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Members can see and edit family budgets, accounts, and transactions. Bank connections stay with their owner. Leaving keeps your own workspaces and removes shared access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los miembros pueden ver y editar presupuestos, cuentas y transacciones familiares. Las conexiones bancarias siguen con su propietario. Al salir conservas tus espacios propios y pierdes el acceso compartido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les membres peuvent voir et modifier les budgets, les comptes et les transactions familiaux. Les connexions bancaires restent chez leur propriétaire. Quitter conserve vos propres espaces de travail et supprime l’accès partagé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I membri possono visualizzare e modificare budget, conti e transazioni familiari. I collegamenti bancari rimangono con il loro proprietario. L'uscita mantiene le proprie aree di lavoro e rimuove l'accesso condiviso."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Članovi mogu da vide i uređuju porodične budžete, račune i transakcije. Bankarske veze ostaju kod svog vlasnika. Napuštanjem zadržavate sopstvene radne prostore i uklanjate deljeni pristup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成员可以查看和编辑家庭预算、账户和交易。银行关系由其所有者保留。离开会保留您自己的工作区并删除共享访问权限。"
          }
        }
      }
    },

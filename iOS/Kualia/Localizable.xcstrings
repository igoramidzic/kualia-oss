        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo registra una transacción en Kualia. No envía un pago ni mueve dinero en tu banco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela enregistre uniquement une transaction dans Kualia. Il n’envoie pas de paiement ni ne transfère d’argent à votre banque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo registra solo una transazione in Kualia. Non invia un pagamento né sposta denaro alla tua banca."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo samo beleži transakciju u Kualia. Ne šalje uplatu niti prenosi novac u vašu banku."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

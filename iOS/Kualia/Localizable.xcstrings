    "The split adds up to %@. Match the transaction total or use this new total." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufteilung ergibt %1$@. Passen Sie die Transaktionssumme an oder verwenden Sie diese neue Summe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The split adds up to %@. Match the transaction total or use this new total."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La división suma %@. Iguala el total de la transacción o usa este nuevo total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La répartition totalise %1$@. Faites correspondre le total de la transaction ou utilisez ce nouveau total."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La divisione si aggiunge a %1$@. Abbina il totale della transazione o utilizza questo nuovo totale."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",

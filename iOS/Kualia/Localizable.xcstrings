    "The extra money still needed to meet your category targets for this month. As you fund those categories, this number goes down." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das zusätzliche Geld, das noch fehlt, um deine Kategorieziele für diesen Monat zu erreichen. Wenn du diesen Kategorien Geld zuweist, sinkt dieser Betrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

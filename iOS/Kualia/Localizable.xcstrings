    "Only accounts with no transactions can be deleted. Close this account to keep its history." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es können nur Konten ohne Transaktionen gelöscht werden. Schließen Sie dieses Konto, um seinen Verlauf beizubehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only accounts with no transactions can be deleted. Close this account to keep its history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se pueden eliminar cuentas sin transacciones. Cierra esta cuenta para conservar su historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les comptes sans transactions peuvent être supprimés. Fermez ce compte pour conserver son historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È possibile eliminare solo i conti senza transazioni. Chiudi questo account per conservarne la cronologia."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo nalozi bez transakcija se mogu izbrisati. Zatvorite ovaj nalog da biste sačuvali njegovu istoriju."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能删除没有交易的账户。关闭此帐户以保留其历史记录。"
          }
        }
      }
    },
    "Only plan with money you have. When new money arrives, give that a job too." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen Sie nur mit dem Geld, das Sie haben. Wenn neues Geld ankommt, versuchen Sie es auch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only plan with money you have. When new money arrives, give that a job too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica solo con dinero que tienes. Cuando llegue más, dale también un propósito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez uniquement avec l’argent dont vous disposez. Lorsque de l’argent frais arrive, donnez-lui aussi du travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica solo con i soldi che hai. Quando arrivano nuovi soldi, date un lavoro anche a quello."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planirajte samo sa novcem koji imate. Kada stigne novi novac, dajte i tome posao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只用你有的钱来计划。当新资金到来时，也给它一份工作。"
          }
        }
      }
    },
    "Only the owner can edit these settings." : {
      "extractionState" : "manual",
      "localizations" : {

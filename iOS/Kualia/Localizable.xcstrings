    "Add a bill, payday, subscription, or something you're planning ahead for." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie eine Rechnung, einen Zahltag, ein Abonnement oder etwas hinzu, das Sie im Voraus planen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a bill, payday, subscription, or something you're planning ahead for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una factura, un día de cobro, una suscripción o algo que estés preparando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une facture, un salaire, un abonnement ou quelque chose que vous planifiez à l'avance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una fattura, un giorno di paga, un abbonamento o qualcosa che stai pianificando in anticipo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte račun, dan isplate, pretplatu ili nešto što planirate unapred."

    "Archived. Your data is kept safe, with syncing and notifications paused." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviert. Ihre Daten werden sicher aufbewahrt, da die Synchronisierung und Benachrichtigungen angehalten werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archived. Your data is kept safe, with syncing and notifications paused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivado. Tus datos se conservan, con la sincronización y las notificaciones en pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivé. Vos données sont conservées en sécurité, la synchronisation et les notifications étant suspendues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archiviato. I tuoi dati sono al sicuro, con la sincronizzazione e le notifiche sospese."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arhivirano. Vaši podaci su bezbedni, a sinhronizacija i obaveštenja su pauzirana."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存档。您的数据会保持安全，同步和通知会暂停。"
          }
        }
      }
    },

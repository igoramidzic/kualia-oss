    "The combined funding your category targets call for this month, including this month's contributions toward longer-term goals. Categories without targets, snoozed targets, and archived categories are left out." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gesamte Finanzierungsbedarf deiner Kategorieziele für diesen Monat, einschließlich der monatlichen Beiträge zu längerfristigen Zielen. Kategorien ohne Ziele, pausierte Ziele und archivierte Kategorien werden nicht berücksichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The combined funding your category targets call for this month, including this month's contributions toward longer-term goals. Categories without targets, snoozed targets, and archived categories are left out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La financiación total que requieren los objetivos de tus categorías este mes, incluidas las aportaciones de este mes a objetivos a largo plazo. No se incluyen las categorías sin objetivos, los objetivos pausados ni las categorías archivadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le financement total demandé ce mois-ci par les objectifs de vos catégories, y compris les contributions de ce mois aux objectifs à plus long terme. Les catégories sans objectif, les objectifs en pause et les catégories archivées sont exclus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il finanziamento complessivo richiesto questo mese dagli obiettivi delle tue categorie, inclusi i contributi di questo mese agli obiettivi a lungo termine. Sono escluse le categorie senza obiettivi, gli obiettivi in pausa e le categorie archiviate."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukupan iznos koji ciljevi tvojih kategorija zahtevaju ovog meseca, uključujući doprinose za dugoročne ciljeve. Kategorije bez ciljeva, odloženi ciljevi i arhivirane kategorije nisu uključeni."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各类别目标在本月需要投入的资金总额，包括本月为长期目标投入的金额。不计入未设目标的类别、已暂停的目标和已归档的类别。"
          }
        }
      }
    },
    "The connection owner" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verbindungseigentümer"

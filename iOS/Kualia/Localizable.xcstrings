    },
    "Touch and hold the widget, choose Edit Widget, and pick a category. Available money divided by the days left, including today, is a pace suggestion, not a spending limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berühren und halten Sie das Widget, wählen Sie „Widget bearbeiten“ und wählen Sie eine Kategorie aus. Das verfügbare Geld dividiert durch die verbleibenden Tage, einschließlich heute, ist ein Tempovorschlag und kein Ausgabenlimit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the widget, choose Edit Widget, and pick a category. Available money divided by the days left, including today, is a pace suggestion, not a spending limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el widget, elige Editar widget y selecciona una categoría. El dinero disponible dividido entre los días restantes, incluido hoy, es una sugerencia de ritmo, no un límite de gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur le widget, choisissez Modifier le widget et choisissez une catégorie. L’argent disponible divisé par les jours restants, y compris aujourd’hui, est une suggestion de rythme et non une limite de dépenses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuto il widget, scegli Modifica widget e scegli una categoria. Il denaro disponibile diviso per i giorni rimasti, compreso oggi, è un suggerimento sul ritmo, non un limite di spesa."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite i držite vidžet, izaberite Uredi vidžet i izaberite kategoriju. Dostupni novac podeljen sa preostalim danima, uključujući današnji, je predlog tempa, a ne ograničenje potrošnje."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触摸并按住小部件，选择“编辑小部件”，然后选择一个类别。可用资金除以剩余天数（包括今天）是一个进度建议，而不是支出限制。"
          }
        }
      }
    },
    "Touch and hold your Lock Screen, tap Customize, then choose Lock Screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berühren und halten Sie Ihren Sperrbildschirm, tippen Sie auf „Anpassen“ und wählen Sie dann „Sperrbildschirm“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold your Lock Screen, tap Customize, then choose Lock Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada tu pantalla bloqueada, toca Personalizar y elige Pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez et maintenez votre écran de verrouillage, appuyez sur Personnaliser, puis choisissez Écran de verrouillage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuta la schermata di blocco, tocca Personalizza, quindi scegli Schermata di blocco."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite i držite zaključani ekran, dodirnite Prilagodi, a zatim izaberite Zaključani ekran."

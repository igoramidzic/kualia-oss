    "Choices come from the last workspace opened in Kualia. Set Workspace in your shortcut to require a specific workspace; leave it empty to use the active one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswahl stammt aus dem zuletzt in Kualia geöffneten Arbeitsbereich. Lege im Kurzbefehl einen Arbeitsbereich fest, um ihn vorauszusetzen; lasse das Feld leer, um den aktiven zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choices come from the last workspace opened in Kualia. Set Workspace in your shortcut to require a specific workspace; leave it empty to use the active one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las opciones proceden del último espacio abierto en Kualia. Configura Espacio de trabajo en el atajo para exigir uno concreto; déjalo vacío para usar el activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les choix proviennent du dernier espace ouvert dans Kualia. Définissez Espace de travail dans le raccourci pour en imposer un ; laissez ce champ vide pour utiliser l’espace actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le opzioni provengono dall’ultimo spazio di lavoro aperto in Kualia. Imposta Spazio di lavoro nel comando per richiederne uno specifico; lascia vuoto per usare quello attivo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcije potiču iz poslednjeg radnog prostora otvorenog u aplikaciji Kualia. Podesite Radni prostor u prečici da zahtevate određeni prostor; ostavite prazno za aktivni."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

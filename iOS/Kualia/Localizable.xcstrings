    "Amounts and due dates come from your planned expenses. Tap to review them in Kualia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beträge und Fälligkeitstermine ergeben sich aus Ihren geplanten Ausgaben. Tippen Sie, um sie in Kualia zu überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amounts and due dates come from your planned expenses. Tap to review them in Kualia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los importes y las fechas provienen de tus gastos planificados. Toca para revisarlos en Kualia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les montants et les dates d'échéance proviennent de vos dépenses prévues. Appuyez pour les consulter dans Kualia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli importi e le scadenze derivano dalle spese pianificate. Tocca per esaminarli in Kualia."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iznosi i datumi dospeća potiču iz vaših planiranih troškova. Dodirnite da biste ih pregledali u Kualia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金额和到期日来自您的计划费用。点击可在 Kualia 中查看它们。"
          }
        }
      }
    },
    "Amounts show the activity matching your report. Open a transaction to see its full amount and every category." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beträge zeigen die Aktivität an, die Ihrem Bericht entspricht. Öffnen Sie eine Transaktion, um den gesamten Betrag und jede Kategorie anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amounts show the activity matching your report. Open a transaction to see its full amount and every category."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los importes muestran la actividad que coincide con el informe. Abre una transacción para ver su importe completo y todas sus categorías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les montants indiquent l'activité correspondant à votre rapport. Ouvrez une transaction pour voir son montant total et chaque catégorie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli importi mostrano l'attività corrispondente al tuo rapporto. Apri una transazione per visualizzarne l'intero importo e ogni categoria."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iznosi pokazuju aktivnost koja odgovara vašem izveštaju. Otvorite transakciju da biste videli njen puni iznos i svaku kategoriju."
          }

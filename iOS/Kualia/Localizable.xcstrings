        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dinero adicional que aún necesitas para cumplir los objetivos de tus categorías este mes. A medida que financias esas categorías, esta cifra disminuye."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

            "value" : "你已经是这个家庭的一员了。"
          }
        }
      }
    },
    "You're in the new workspace, but we couldn't remember it for your next visit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie befinden sich im neuen Arbeitsbereich, aber wir konnten uns bei Ihrem nächsten Besuch nicht daran erinnern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're in the new workspace, but we couldn't remember it for your next visit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás en el nuevo espacio, pero no pudimos recordarlo para la próxima visita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes dans le nouvel espace de travail, mais nous n'avons pas pu nous en souvenir pour votre prochaine visite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti trovi nella nuova area di lavoro, ma non siamo riusciti a ricordarla per la tua prossima visita."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",

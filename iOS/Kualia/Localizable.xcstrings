    "Includes posted inflow and outflow. Tap to show all activity." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält gebuchte Einnahmen und Ausgaben. Tippen, um alle Aktivitäten anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes posted inflow and outflow. Tap to show all activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye ingresos y gastos contabilizados. Toca para ver toda la actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclut les entrées et sorties comptabilisées. Touchez pour afficher toute l’activité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include entrate e uscite contabilizzate. Tocca per mostrare tutte le attività."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obuhvata proknjižene prilive i odlive. Dodirnite za prikaz svih aktivnosti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含已入账的流入和流出。轻点以显示所有交易。"
          }
        }
      }
    },

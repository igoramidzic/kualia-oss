    "Monthly funding includes your targets and spending beyond them. Fully funded means both are covered." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die monatliche Finanzierung umfasst deine Ziele und darüber hinausgehende Ausgaben. Vollständig finanziert bedeutet, dass beides gedeckt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly funding includes your targets and spending beyond them. Fully funded means both are covered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La financiación mensual incluye tus objetivos y los gastos que los superan. Totalmente financiado significa que ambos están cubiertos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le financement mensuel comprend vos objectifs et les dépenses qui les dépassent. Un financement complet signifie que les deux sont couverts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il finanziamento mensile comprende i tuoi obiettivi e le spese che li superano. Completamente finanziato significa che entrambi sono coperti."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesečno finansiranje obuhvata ciljeve i potrošnju iznad njih. Potpuno finansirano znači da je oboje pokriveno."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月资金分配包括目标所需资金及超出目标的支出。“资金已全部到位”表示两者均已覆盖。"
          }
        }
      }
    },

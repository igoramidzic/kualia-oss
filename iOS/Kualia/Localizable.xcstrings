    " Your current family group will be deleted and its pending invitations revoked." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Ihre aktuelle Familiengruppe wird gelöscht und die ausstehenden Einladungen werden widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Your current family group will be deleted and its pending invitations revoked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Se eliminará tu grupo familiar actual y se revocarán sus invitaciones pendientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Votre groupe familial actuel sera supprimé et ses invitations en attente révoquées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Il tuo attuale gruppo Famiglia verrà eliminato e i suoi inviti in sospeso verranno revocati."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Vaša trenutna porodična grupa će biti obrisana, a pozivi na čekanju će biti opozvani."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 您当前的家庭组将被删除，其待处理的邀请将被撤销。"
          }
        }
      }
    },

    "Add a checking, savings, or other banking account with money in it. Connect your bank, or enter a balance yourself." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie ein Giro-, Spar- oder anderes Bankkonto mit Geld hinzu. Verbinden Sie Ihre Bank oder geben Sie selbst einen Kontostand ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a checking, savings, or other banking account with money in it. Connect your bank, or enter a balance yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una cuenta corriente, de ahorro u otra cuenta bancaria con dinero. Conecta tu banco o introduce un saldo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un compte chèque, d’épargne ou autre compte bancaire contenant de l’argent. Connectez votre banque ou saisissez vous-même un solde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un conto corrente, un conto di risparmio o un altro conto bancario con denaro al suo interno. Collega la tua banca o inserisci tu stesso il saldo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {

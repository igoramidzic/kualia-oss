    "Use a fixed value, Ask Each Time, or a variable from another action. Kualia opens for review; tap Add or Schedule to save." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende einen festen Wert, Jedes Mal fragen oder eine Variable aus einer anderen Aktion. Kualia öffnet sich zur Prüfung; tippe zum Speichern auf Hinzufügen oder Planen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a fixed value, Ask Each Time, or a variable from another action. Kualia opens for review; tap Add or Schedule to save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un valor fijo, Preguntar cada vez o una variable de otra acción. Kualia se abre para revisar; toca Añadir o Programar para guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une valeur fixe, Demander à chaque fois ou une variable d’une autre action. Kualia s’ouvre pour vérification ; touchez Ajouter ou Planifier pour enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un valore fisso, Chiedi ogni volta o una variabile di un’altra azione. Kualia si apre per la revisione; tocca Aggiungi o Pianifica per salvare."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite fiksnu vrednost, Pitaj svaki put ili promenljivu iz druge radnje. Kualia se otvara za pregled; dodirnite Dodaj ili Zakaži da sačuvate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用固定值、“每次询问”或其他操作的变量。Kualia 会打开供你检查；轻点“添加”或“计划”即可保存。"
          }
        }
      }

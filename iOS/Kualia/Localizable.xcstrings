    "Bank updates may be paused. Review your connection to get them flowing again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bankaktualisierungen können angehalten werden. Überprüfen Sie Ihre Verbindung, um sie wieder zum Fließen zu bringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bank updates may be paused. Review your connection to get them flowing again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones bancarias podrían estar en pausa. Revisa la conexión para reanudarlas."

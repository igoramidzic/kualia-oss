        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour bancaires peuvent être suspendues. Vérifiez votre connexion pour qu'elle circule à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti bancari potrebbero essere sospesi. Rivedi la tua connessione per farli fluire di nuovo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranja banke mogu biti pauzirana. Pregledajte svoju vezu da biste ih ponovo pokrenuli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "银行更新可能会暂停。检查您的连接以使它们再次流动。"
          }
        }
      }
    },
    "Bank updates will stop for accounts using this connection in every workspace. Your Kualia accounts and transaction history will be kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bankaktualisierungen werden für Konten, die diese Verbindung verwenden, in jedem Arbeitsbereich gestoppt. Ihre Kualia-Konten und der Transaktionsverlauf werden gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bank updates will stop for accounts using this connection in every workspace. Your Kualia accounts and transaction history will be kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detendrán las actualizaciones de las cuentas que usan esta conexión en todos los espacios. Se conservarán tus cuentas e historial de transacciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour bancaires s'arrêteront pour les comptes utilisant cette connexion dans chaque espace de travail. Vos comptes Kualia et l'historique des transactions seront conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti bancari verranno interrotti per gli account che utilizzano questa connessione in ogni area di lavoro. I tuoi account Kualia e la cronologia delle transazioni verranno conservati."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranja banke će se zaustaviti za račune koji koriste ovu vezu u svakom radnom prostoru. Vaši Kualia nalozi i istorija transakcija će biti sačuvani."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于每个工作区中使用此连接的帐户，银行更新将停止。您的 Kualia 帐户和交易历史记录将被保留。"
          }
        }
      }
    },

    "The original information from your bank is kept for reference. Your edits won't replace it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Originalinformationen Ihrer Bank werden als Referenz aufbewahrt. Ihre Änderungen werden es nicht ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The original information from your bank is kept for reference. Your edits won't replace it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La información original del banco se conserva como referencia. Tus cambios no la sustituirán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations originales de votre banque sont conservées à titre de référence. Vos modifications ne le remplaceront pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le informazioni originali della tua banca vengono conservate come riferimento. Le tue modifiche non lo sostituiranno."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originalne informacije iz vaše banke čuvaju se za referencu. Vaše izmene ga neće zameniti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留您银行的原始信息以供参考。您的编辑不会取代它。"
          }
        }
      }
    },

    "Small windows into the things that matter. Find your favorites, choose a mood, and give them a home." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine Fenster zu den Dingen, die wichtig sind. Finden Sie Ihre Favoriten, wählen Sie eine Stimmung und geben Sie ihnen ein Zuhause."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small windows into the things that matter. Find your favorites, choose a mood, and give them a home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequeñas ventanas a lo que importa. Encuentra tus favoritos, elige un estilo y dales un hogar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De petites fenêtres sur les choses qui comptent. Trouvez vos favoris, choisissez une ambiance et offrez-leur une maison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piccole finestre sulle cose che contano. Trova i tuoi preferiti, scegli uno stato d'animo e dai loro una casa."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mali prozori u stvari koje su važne. Pronađite svoje favorite, izaberite raspoloženje i dajte im dom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过小窗口了解重要的事情。找到您最喜欢的东西，选择一种心情，然后给它们一个家。"
          }
        }
      }
    },

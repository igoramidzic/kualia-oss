    "Leaves your balances unchanged and keeps a skipped record. A repeating transaction moves to its next future date." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt Ihre Guthaben unverändert und führt eine Aufzeichnung der übersprungenen Daten. Eine wiederkehrende Transaktion wird auf ihr nächstes zukünftiges Datum verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaves your balances unchanged and keeps a skipped record. A repeating transaction moves to its next future date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene tus saldos y deja un registro de omisión. Una transacción recurrente avanza a su próxima fecha futura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse vos soldes inchangés et conserve un enregistrement ignoré. Une transaction répétitive se déplace vers sa prochaine date future."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia invariati i tuoi saldi e conserva un record saltato. Una transazione ricorrente si sposta alla data futura successiva."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostavlja vaše stanje nepromenjenim i vodi preskočenu evidenciju. Transakcija koja se ponavlja se pomera na sledeći budući datum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持您的余额不变并保留跳过的记录。重复交易移至下一个未来日期。"
          }
        }
      }
    },

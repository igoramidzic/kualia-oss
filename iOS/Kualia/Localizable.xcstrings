    "You've assigned more than you have. Lower the amount until Ready to Assign is zero or above." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben mehr Geld zugewiesen, als Sie haben. Verringern Sie den Betrag, bis „Zum Zuweisen verfügbar“ mindestens null beträgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've assigned more than you have. Lower the amount until Ready to Assign is zero or above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has asignado más de lo que tienes. Reduce el importe hasta que Listo para asignar sea cero o más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez attribué plus d’argent que vous n’en avez. Réduisez le montant jusqu’à ce que À attribuer soit au moins égal à zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai assegnato più denaro di quello che hai. Riduci l’importo finché Da assegnare non è pari o superiore a zero."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodelili ste više nego što imate. Smanjite iznos dok Readi to Assign ne bude nula ili više."

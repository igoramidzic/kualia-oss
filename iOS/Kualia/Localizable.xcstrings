    "Pick what matters. We'll give those goals their own categories." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie aus, worauf es ankommt. Wir geben diesen Zielen eigene Kategorien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick what matters. We'll give those goals their own categories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige lo que importa. Daremos a esos objetivos sus propias categorías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce qui compte. Nous attribuerons à ces objectifs leurs propres catégories."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli ciò che conta. Daremo a questi obiettivi le rispettive categorie."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izaberite ono što je važno. Daćemo tim golovima njihove kategorije."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择重要的。我们将为这些目标划分自己的类别。"
          }
        }
      }
    },
    "Pinch to zoom and drag to position your photo. Swipe up or down to adjust zoom." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Zoomen drücken und ziehen, um das Foto zu positionieren. Wischen Sie nach oben oder unten, um den Zoom anzupassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch to zoom and drag to position your photo. Swipe up or down to adjust zoom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pellizca para ampliar y arrastra para colocar la foto. Desliza arriba o abajo para ajustar el zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez pour zoomer et faites glisser pour positionner votre photo. Faites glisser votre doigt vers le haut ou vers le bas pour régler le zoom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica per ingrandire e trascina per posizionare la foto. Scorri verso l'alto o verso il basso per regolare lo zoom."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stisnite prste da biste zumirali i prevucite da biste pozicionirali svoju fotografiju. Prevucite nagore ili nadole da biste podesili zum."

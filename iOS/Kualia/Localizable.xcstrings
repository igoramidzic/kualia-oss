    "On your Home Screen, edit Category Balances and choose %@ first. Its saved photo appears for that size." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite Kategorie-Guthaben auf deinem Home-Bildschirm und wähle %@ zuerst. Das gespeicherte Foto erscheint für diese Größe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Home Screen, edit Category Balances and choose %@ first. Its saved photo appears for that size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la pantalla de inicio, edita Saldos de categorías y elige %@ primero. Su foto guardada aparece para ese tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’écran d’accueil, modifiez Soldes des catégories et choisissez %@ en premier. Sa photo enregistrée apparaît pour cette taille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella schermata Home, modifica Saldi delle categorie e scegli prima %@. La foto salvata appare per quella dimensione."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na početnom ekranu uredi Stanja kategorija i prvo izaberi %@. Sačuvana fotografija se prikazuje za tu veličinu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主屏幕上编辑“类别余额”，并首先选择 %@。该尺寸将显示其保存的照片。"
          }
        }
      }
    },
    "On your Home Screen, touch and hold Daily Budget, choose Edit Widget, then select %@. Its saved photo appears automatically for that size." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berühren und halten Sie auf Ihrem Startbildschirm das Tagesbudget, wählen Sie „Widget bearbeiten“ und dann %1$@. Das gespeicherte Foto wird automatisch für diese Größe angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Home Screen, touch and hold Daily Budget, choose Edit Widget, then select %@. Its saved photo appears automatically for that size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu pantalla de inicio, mantén pulsado Presupuesto diario, elige Editar widget y selecciona %@. Su foto guardada aparecerá automáticamente para ese tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre écran d'accueil, touchez et maintenez Budget quotidien, choisissez Modifier le widget, puis sélectionnez %1$@. Sa photo enregistrée apparaît automatiquement pour cette taille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella schermata Home, tocca e tieni premuto Budget giornaliero, scegli Modifica widget, quindi seleziona %1$@. La foto salvata viene visualizzata automaticamente per quella dimensione."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na početnom ekranu dodirnite i držite Dnevni budžet, izaberite Uredi vidžet, a zatim izaberite %1$@. Njegova sačuvana fotografija se automatski pojavljuje za tu veličinu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主屏幕上，触摸并按住“每日预算”，选择“编辑小部件”，然后选择“%1$@”。其保存的照片会自动显示该尺寸。"
          }
        }
      }
    },

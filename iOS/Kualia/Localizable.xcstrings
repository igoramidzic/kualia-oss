    "This connection is being disconnected. The request may still finish if you leave. Your Kualia accounts and transaction history will be kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verbindung wird getrennt. Die Anfrage wird möglicherweise trotzdem abgeschlossen, wenn Sie gehen. Ihre Kualia-Konten und der Transaktionsverlauf werden gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This connection is being disconnected. The request may still finish if you leave. Your Kualia accounts and transaction history will be kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está desconectando esta conexión. La solicitud podría completarse aunque salgas. Se conservarán tus cuentas e historial de Kualia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion est en cours de déconnexion. La demande peut encore se terminer si vous partez. Vos comptes Kualia et l'historique des transactions seront conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa connessione è in fase di disconnessione. La richiesta potrebbe comunque essere completata se esci. I tuoi account Kualia e la cronologia delle transazioni verranno conservati."

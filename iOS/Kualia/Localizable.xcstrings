    "With your permission, AppsFlyer and our ad partners can use your device’s advertising identifier to understand which ads led to installs and signups." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Ihrer Erlaubnis können AppsFlyer und unsere Werbepartner die Werbekennung Ihres Geräts verwenden, um zu ermitteln, welche Anzeigen zu Installationen und Registrierungen geführt haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your permission, AppsFlyer and our ad partners can use your device’s advertising identifier to understand which ads led to installs and signups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tu permiso, AppsFlyer y nuestros socios publicitarios pueden usar el identificador publicitario de tu dispositivo para saber qué anuncios generaron instalaciones y registros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec votre autorisation, AppsFlyer et nos partenaires publicitaires peuvent utiliser l’identifiant publicitaire de votre appareil pour savoir quelles publicités ont mené à des installations et inscriptions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con il tuo consenso, AppsFlyer e i nostri partner pubblicitari possono usare l’identificativo pubblicitario del dispositivo per capire quali annunci hanno portato a installazioni e registrazioni."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz vašu dozvolu, AppsFlyer i naši oglašivački partneri mogu da koriste oglašivački identifikator vašeg uređaja da bi utvrdili koji oglasi dovode do instalacija i registracija."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经您允许，AppsFlyer 和我们的广告合作伙伴可以使用您设备的广告标识符，了解哪些广告带来了安装和注册。"
          }
        }
      }
    },

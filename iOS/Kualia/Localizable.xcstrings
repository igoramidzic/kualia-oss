    "Widgets follow the workspace you last opened. Updates arrive on iOS's schedule, so open Kualia when you need the latest details." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets folgen dem Arbeitsbereich, den Sie zuletzt geöffnet haben. Updates kommen nach dem Zeitplan von iOS an, also öffnen Sie Kualia, wenn Sie die neuesten Details benötigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets follow the workspace you last opened. Updates arrive on iOS's schedule, so open Kualia when you need the latest details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los widgets siguen el último espacio que abriste. iOS decide cuándo actualizarlos; abre Kualia para ver los datos más recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les widgets suivent l'espace de travail que vous avez ouvert pour la dernière fois. Les mises à jour arrivent selon le calendrier d'iOS, alors ouvrez Kualia lorsque vous avez besoin des derniers détails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I widget seguono l'ultima area di lavoro aperta. Gli aggiornamenti arrivano secondo il programma di iOS, quindi apri Kualia quando hai bisogno degli ultimi dettagli."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidžeti prate radni prostor koji ste poslednji put otvorili. Ažuriranja stižu po rasporedu iOS-a, pa otvorite Kualia kada vam zatrebaju najnoviji detalji."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小部件遵循您上次打开的工作区。更新按照 iOS 的时间表进行，因此当您需要最新详细信息时，请打开 Kualia。"
          }
        }
      }
    },

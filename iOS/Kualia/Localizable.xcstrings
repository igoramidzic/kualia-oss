    "Ask %@ to check the family membership to restore shared access." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitten Sie %1$@, die Familienmitgliedschaft zu überprüfen, um den gemeinsamen Zugriff wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %@ to check the family membership to restore shared access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a %@ que revise la suscripción familiar para recuperar el acceso compartido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à %1$@ de vérifier l'adhésion familiale pour restaurer l'accès partagé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a %1$@ di verificare l'appartenenza alla famiglia per ripristinare l'accesso condiviso."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamolite %1$@ da proveri porodično članstvo da vrati deljeni pristup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求 %1$@ 检查家庭成员身份以恢复共享访问。"
          }
        }
      }
    },
    "Ask a question, make a plan, or bring a receipt." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {

    "Top %lld of %lld. All activity is included in the total and transaction list." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top %1$lld von %2$lld. Alle Aktivitäten sind in der Gesamt- und Transaktionsliste enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top %lld of %lld. All activity is included in the total and transaction list."
          }

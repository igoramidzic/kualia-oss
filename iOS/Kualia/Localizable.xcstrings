        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La correspondance de texte ignore la casse. Les importations utilisent le nom du commerçant de la banque ; les transactions existantes utilisent leur marchand actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La corrispondenza del testo ignora le maiuscole e minuscole. Le importazioni utilizzano il nome commerciale della banca; le transazioni esistenti utilizzano il loro attuale commerciante."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podudaranje teksta zanemaruje velika i mala slova. Uvoz koristi naziv trgovca banke; postojeće transakcije koriste svog trenutnog trgovca."

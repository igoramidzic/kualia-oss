    "A target is the amount you want to set aside each month. It guides your plan; it doesn't move money." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ziel ist der Betrag, den Sie jeden Monat beiseite legen möchten. Es leitet Ihren Plan; es bewegt kein Geld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A target is the amount you want to set aside each month. It guides your plan; it doesn't move money."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objetivo es el importe que quieres apartar cada mes. Orienta tu plan; no mueve dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un objectif est le montant que vous souhaitez mettre de côté chaque mois. Il guide votre plan ; cela ne déplace pas d'argent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

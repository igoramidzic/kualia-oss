    "Money in minus money out. Above zero means more came in than went out." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geld rein minus Geld raus. Über Null bedeutet, dass mehr eingegangen ist als ausgegeben wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Money in minus money out. Above zero means more came in than went out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinero que entra menos dinero que sale. Por encima de cero significa que entró más de lo que salió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argent entrant moins argent sortant. Au-dessus de zéro, cela signifie qu’il y a plus d’entrées que de sorties."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soldi in entrata meno soldi in uscita. Sopra lo zero significa che sono entrate più di quante ne sono uscite."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novac u minus novac. Iznad nule znači da je više ušlo nego izašlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "资金流入减去资金流出。高于零意味着流入多于流出。"
          }
        }
      }
    },

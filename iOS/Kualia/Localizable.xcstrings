    "This transaction will be planned for its future date. Your balances will change when it is entered." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Transaktion wird für den zukünftigen Zeitpunkt geplant. Ihr Guthaben ändert sich, wenn es eingegeben wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This transaction will be planned for its future date. Your balances will change when it is entered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transacción quedará planificada para su fecha futura. Tus saldos cambiarán cuando se registre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette transaction sera planifiée pour sa date ultérieure. Vos soldes changeront lors de leur saisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa transazione sarà pianificata per la sua data futura. I tuoi saldi cambieranno quando verrà inserito."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova transakcija će biti planirana za budući datum. Vaše stanje će se promeniti kada ga unesete."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该交易将计划在未来的日期进行。输入后您的余额将会发生变化。"
          }
        }
      }
    },
    "This updates all existing transactions that match this rule, including reviewed transactions. A category action changes the first category of a split. The count can change as new transactions arrive." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle vorhandenen Transaktionen aktualisiert, die dieser Regel entsprechen, einschließlich überprüfter Transaktionen. Eine Kategorieaktion ändert die erste Kategorie einer Aufteilung. Die Anzahl kann sich ändern, wenn neue Transaktionen eingehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This updates all existing transactions that match this rule, including reviewed transactions. A category action changes the first category of a split. The count can change as new transactions arrive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto actualiza todas las transacciones existentes que coincidan, incluidas las revisadas. Una acción de categoría cambia la primera categoría de una división. El recuento puede cambiar al llegar nuevas transacciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela met à jour toutes les transactions existantes qui correspondent à cette règle, y compris les transactions examinées. Une action de catégorie modifie la première catégorie d'un fractionnement. Le décompte peut changer à mesure que de nouvelles transactions arrivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò aggiorna tutte le transazioni esistenti che corrispondono a questa regola, comprese le transazioni riviste. Un'azione di categoria modifica la prima categoria di una divisione. Il conteggio può cambiare con l'arrivo di nuove transazioni."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo ažurira sve postojeće transakcije koje odgovaraju ovom pravilu, uključujući pregledane transakcije. Radnja kategorije menja prvu kategoriju podele. Broj se može promeniti kako pristižu nove transakcije."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会更新与此规则匹配的所有现有交易，包括已审核的交易。类别操作更改拆分的第一个类别。随着新交易的到来，计数可能会发生变化。"
          }
        }
      }
    },

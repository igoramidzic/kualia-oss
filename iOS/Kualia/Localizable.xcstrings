    "Your family group will be deleted and pending invitations revoked. Your Kualia account and own workspaces stay intact." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Familiengruppe wird gelöscht und ausstehende Einladungen widerrufen. Ihr Kualia-Konto und Ihre eigenen Arbeitsbereiche bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your family group will be deleted and pending invitations revoked. Your Kualia account and own workspaces stay intact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará tu grupo familiar y se revocarán las invitaciones pendientes. Tu cuenta de Kualia y tus propios espacios se conservarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre groupe familial sera supprimé et les invitations en attente révoquées. Votre compte Kualia et vos propres espaces de travail restent intacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

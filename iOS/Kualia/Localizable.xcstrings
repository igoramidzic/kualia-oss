            "value" : "Kategorien mit Zielen ergeben Ihren monatlichen Gesamtbetrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categories with targets make up your monthly number."
          }
        },
        "es" : {
          "stringUnit" : {

    "Set the amount, expense or income, merchant, account, category, date, notes, and repeat schedule. For transfers, choose Transfer and a destination account." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Betrag, Ausgabe oder Einnahme, Händler, Konto, Kategorie, Datum, Notizen und Wiederholung fest. Für Überweisungen wähle Überweisung und ein Zielkonto."
          }
        },
        "en" : {
          "stringUnit" : {

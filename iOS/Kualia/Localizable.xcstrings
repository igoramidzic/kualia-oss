            "value" : "Einige Angaben im Kurzbefehl fehlen oder passen zu mehreren Einträgen. Prüfe Konto, Kategorie und Händler vor dem Speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some shortcut choices are missing or match more than one item. Review the account, category, and merchant before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas opciones del atajo faltan o coinciden con varios elementos. Revisa la cuenta, la categoría y el comercio antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains choix du raccourci sont introuvables ou correspondent à plusieurs éléments. Vérifiez le compte, la catégorie et le commerçant avant d’enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

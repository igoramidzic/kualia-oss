    "I’m the founder of Kualia. Thanks for making it part of your day." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin der Gründer von Kualia. Vielen Dank, dass Sie es zu einem Teil Ihres Tages gemacht haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I’m the founder of Kualia. Thanks for making it part of your day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soy el fundador de Kualia. Gracias por hacerla parte de tu día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis le fondateur de Kualia. Merci de l'avoir intégré à votre journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono il fondatore di Kualia. Grazie per averlo reso parte della tua giornata."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja sam osnivač Kualia. Hvala što ste to učinili delom vašeg dana."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我是Kualia的创始人。感谢您让它成为您一天的一部分。"
          }
        }
      }
    },
    "If you have a moment, I’d really appreciate a review. Your honest feedback helps me make Kualia better and helps more people find it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie einen Moment Zeit haben, würde ich mich sehr über eine Bewertung freuen. Ihr ehrliches Feedback hilft mir, Kualia besser zu machen und hilft mehr Menschen, es zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have a moment, I’d really appreciate a review. Your honest feedback helps me make Kualia better and helps more people find it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes un momento, te agradecería mucho una reseña. Tu opinión sincera me ayuda a mejorar Kualia y a que más personas la descubran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez un moment, j'apprécierais vraiment une critique. Vos commentaires honnêtes m'aident à améliorer Kualia et aident davantage de personnes à le trouver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai un momento, apprezzerei davvero una recensione. Il tuo feedback onesto mi aiuta a migliorare Kualia e aiuta più persone a trovarlo."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako imate trenutak, zaista bih cenio pregled. Vaše iskrene povratne informacije pomažu mi da poboljšam Kualia i pomažete većem broju ljudi da ga pronađe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您有时间，我非常感谢您的评论。您诚实的反馈帮助我使 Kualia 变得更好并帮助更多的人找到它。"
          }
        }
      }
    },

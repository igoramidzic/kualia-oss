    "This month's target contributions plus spending beyond them. Overspending in categories without targets or with snoozed targets is included. Archived categories are excluded." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zielbeiträge dieses Monats plus darüber hinausgehende Ausgaben. Mehrausgaben in Kategorien ohne Ziel oder mit pausiertem Ziel zählen mit. Archivierte Kategorien sind ausgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This month's target contributions plus spending beyond them. Overspending in categories without targets or with snoozed targets is included. Archived categories are excluded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aportaciones a los objetivos de este mes más los gastos que los superan. Se incluyen los gastos excesivos de categorías sin objetivos o con objetivos pausados. Se excluyen las categorías archivadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contributions aux objectifs du mois, plus les dépenses qui les dépassent. Les dépassements des catégories sans objectif ou avec un objectif en pause sont inclus. Les catégories archivées sont exclues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contributi agli obiettivi del mese più le spese che li superano. Sono incluse le spese in eccesso delle categorie senza obiettivi o con obiettivi sospesi. Le categorie archiviate sono escluse."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doprinosi ciljevima ovog meseca i potrošnja iznad njih. Uključena su prekoračenja u kategorijama bez cilja ili sa pauziranim ciljem. Arhivirane kategorije nisu uključene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本月目标所需资金加上超出目标的支出。没有目标或目标已暂停的类别发生的超支也会计入。已归档的类别不计入。"
          }
        }
      }
    },
    "This only records a transaction in Kualia. It doesn't send a payment or move money at your bank." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird nur eine Transaktion in Kualia erfasst. Es wird keine Zahlung gesendet oder Geld bei Ihrer Bank verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This only records a transaction in Kualia. It doesn't send a payment or move money at your bank."

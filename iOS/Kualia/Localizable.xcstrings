    "Kualia stops renewal of web trials and subscriptions. App Store subscriptions must be canceled separately in Apple Subscriptions." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kualia stoppt die Erneuerung von Web-Testversionen und Abonnements. App Store-Abonnements müssen separat in Apple-Abonnements gekündigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kualia stops renewal of web trials and subscriptions. App Store subscriptions must be canceled separately in Apple Subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kualia detiene la renovación de las pruebas y suscripciones web. Las suscripciones del App Store deben cancelarse por separado en Suscripciones de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kualia arrête le renouvellement des essais Web et des abonnements. Les abonnements à l'App Store doivent être annulés séparément dans les abonnements Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kualia interrompe il rinnovo delle prove web e degli abbonamenti. Gli abbonamenti all'App Store devono essere annullati separatamente in Abbonamenti Apple."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kualia zaustavlja obnavljanje veb probnih verzija i pretplata. Pretplate na App Store moraju se posebno otkazati u Apple pretplatama."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kualia 停止续订网络试用和订阅。 App Store 订阅必须在 Apple 订阅中单独取消。"

    "Opening Kualia on iOS or the web counts once a day. Every day adds up, even when you take a break." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Öffnen von Kualia auf iOS oder im Web zählt einmal pro Tag. Jeder Tag zählt dazu, auch wenn Sie zwischendurch eine Pause machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opening Kualia on iOS or the web counts once a day. Every day adds up, even when you take a break."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir Kualia en iOS o en la web cuenta una vez al día. Cada día suma, aunque te tomes un descanso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir Kualia sur iOS ou sur le web compte une fois par jour. Chaque jour s’ajoute au total, même si vous faites une pause de temps en temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprire Kualia su iOS o sul web conta una volta al giorno. Ogni giorno si aggiunge al totale, anche se ogni tanto fai una pausa."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvaranje aplikacije Kualia na iOS-u ili vebu računa se jednom dnevno. Svaki dan se sabira, čak i kada napravite pauzu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天打开 iOS 版或网页版 Kualia 都会记为一次签到。即使中途休息，累计天数也不会清零。"
          }
        }
      }
    },

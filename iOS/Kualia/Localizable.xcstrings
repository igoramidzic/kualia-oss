        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura el importe, gasto o ingreso, comercio, cuenta, categoría, fecha, notas y repetición. Para transferencias, elige Transferencia y una cuenta de destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

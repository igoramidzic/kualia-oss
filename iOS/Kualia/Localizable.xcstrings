          }
        }
      }
    },
    "This removes the workspace and access to its financial data for everyone sharing it. Type %@ to confirm." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch entfällt der Arbeitsbereich und der Zugriff auf seine Finanzdaten für alle, die ihn teilen. Geben Sie zur Bestätigung %1$@ ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes the workspace and access to its financial data for everyone sharing it. Type %@ to confirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina el espacio y el acceso a sus datos financieros para todas las personas que lo comparten. Escribe %@ para confirmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime l'espace de travail et l'accès à ses données financières pour toutes les personnes qui le partagent. Tapez %1$@ pour confirmer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò rimuove lo spazio di lavoro e l'accesso ai relativi dati finanziari per tutti coloro che lo condividono. Digitare %1$@ per confermare."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo uklanja radni prostor i pristup njegovim finansijskim podacima za sve koji ga dele. Unesite %1$@ da biste potvrdili."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除工作区以及共享该工作区的每个人对其财务数据的访问权限。输入 %1$@ 进行确认。"
          }
        }
      }
    },

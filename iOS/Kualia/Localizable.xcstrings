    "Custom backgrounds appear on Home Screen widgets. Lock Screen widgets and the Control Center control follow your system appearance." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Hintergründe erscheinen in Widgets auf dem Home-Bildschirm. Widgets auf dem Sperrbildschirm und das Steuerelement im Kontrollzentrum verwenden das Erscheinungsbild des Systems."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom backgrounds appear on Home Screen widgets. Lock Screen widgets and the Control Center control follow your system appearance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fondos personalizados aparecen en los widgets de la pantalla de inicio. Los widgets de la pantalla de bloqueo y el control del Centro de control siguen la apariencia del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les arrière-plans personnalisés s’affichent dans les widgets de l’écran d’accueil. Les widgets de l’écran verrouillé et la commande du Centre de contrôle suivent l’apparence du système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli sfondi personalizzati appaiono nei widget della schermata Home. I widget della schermata di blocco e il controllo del Centro di Controllo seguono l’aspetto del sistema."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagođene pozadine se prikazuju na vidžetima početnog ekrana. Vidžeti zaključanog ekrana i kontrola u Kontrolnom centru prate izgled sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义背景会显示在主屏幕小组件上。锁定屏幕小组件和控制中心控件会遵循系统外观。"
          }
        }
      }
    },
    "Custom backgrounds appear on Home Screen widgets. The Lock Screen shortcut and Control Center control follow your system appearance." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Hintergründe werden auf Startbildschirm-Widgets angezeigt. Die Verknüpfung zum Sperrbildschirm und die Steuerung im Kontrollzentrum folgen Ihrem Systemerscheinungsbild."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom backgrounds appear on Home Screen widgets. The Lock Screen shortcut and Control Center control follow your system appearance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fondos personalizados aparecen en los widgets de la pantalla de inicio. El acceso de la pantalla bloqueada y el control del Centro de control siguen el aspecto del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des arrière-plans personnalisés apparaissent sur les widgets de l'écran d'accueil. Le raccourci de l'écran de verrouillage et le contrôle du centre de contrôle suivent l'apparence de votre système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli sfondi personalizzati vengono visualizzati sui widget della schermata iniziale. Il collegamento alla schermata di blocco e il controllo del Centro di controllo seguono l'aspetto del tuo sistema."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagođene pozadine se pojavljuju na vidžetima početnog ekrana. Prečica na zaključanom ekranu i kontrola Kontrolnog centra prate izgled vašeg sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义背景出现在主屏幕小部件上。锁定屏幕快捷方式和控制中心控件遵循您的系统外观。"
          }
        }
      }
    },

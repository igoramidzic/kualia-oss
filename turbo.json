{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig*.json",
    "angular.json",
    "scripts/**"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../public/**",
        "../convex/**",
        "!../public/local-session.json"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    }
  }
}
